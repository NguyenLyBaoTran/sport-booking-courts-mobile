APP_NAME=Sports Court Booking API
APP_ENV=development
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/sports_court_booking
USER_DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/sports_user_db
COURT_DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/sports_court_db
BOOKING_DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/sports_booking_db
PAYMENT_DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@127.0.0.1:3306/sports_payment_db
USER_SERVICE_URL=http://127.0.0.1:8001
COURT_SERVICE_URL=http://127.0.0.1:8002
BOOKING_SERVICE_URL=http://127.0.0.1:8003
PAYMENT_SERVICE_URL=http://127.0.0.1:8004
# Set the same local-only value used by User Service; generate a random secret with 32+ characters.
JWT_SECRET_KEY=YOUR_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
INTERNAL_SERVICE_TOKEN=SET_THE_SAME_RANDOM_LOCAL_VALUE_IN_BOOKING_AND_COURT
BOOKING_HOLD_MINUTES=10
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
