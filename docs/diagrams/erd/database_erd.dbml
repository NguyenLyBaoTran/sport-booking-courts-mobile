
Enum user_role {
  USER
  OWNER
  ADMIN
}

Enum booking_status {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  EXPIRED
}

Enum payment_status {
  PENDING
  PAID
  FAILED
  CANCELLED
}

Table users {
  id int [pk, increment]
  full_name varchar(150) [not null]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  phone varchar(20)
  role user_role [not null, default: 'USER']
  is_active boolean [not null, default: true]
  created_at datetime [not null]
}

Table sports {
  id int [pk, increment]
  name varchar(100) [not null, unique]
  description text
  is_active boolean [not null, default: true]
}

Table venues {
  id int [pk, increment]
  owner_id int [not null, ref: > users.id]
  name varchar(200) [not null]
  address varchar(255) [not null]
  description text
  phone varchar(20)
  is_active boolean [not null, default: true]
  created_at datetime [not null]
}

Table courts {
  id int [pk, increment]
  venue_id int [not null, ref: > venues.id]
  sport_id int [not null, ref: > sports.id]
  name varchar(100) [not null]
  description text
  price_per_hour decimal(12,2) [not null]
  is_active boolean [not null, default: true]
}

Table time_slots {
  id int [pk, increment]
  court_id int [not null, ref: > courts.id]
  slot_date date [not null]
  start_time time [not null]
  end_time time [not null]
  is_active boolean [not null, default: true]

  indexes {
    (court_id, slot_date, start_time, end_time) [unique]
  }
}

Table bookings {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  time_slot_id int [not null, ref: > time_slots.id]
  status booking_status [not null, default: 'PENDING']
  total_amount decimal(12,2) [not null]
  expires_at datetime
  qr_token varchar(255) [unique]
  created_at datetime [not null]
}

Table payments {
  id int [pk, increment]
  booking_id int [not null, ref: > bookings.id]
  provider varchar(30) [not null, default: 'MOCK']
  status payment_status [not null, default: 'PENDING']
  amount decimal(12,2) [not null]
  transaction_code varchar(100) [unique]
  created_at datetime [not null]
}

Table checkins {
  id int [pk, increment]
  booking_id int [not null, unique, ref: > bookings.id]
  checked_in_by int [not null, ref: > users.id]
  checked_in_at datetime [not null]
}

Table reviews {
  id int [pk, increment]
  booking_id int [not null, unique, ref: > bookings.id]
  rating int [not null]
  comment text
  created_at datetime [not null]
}
