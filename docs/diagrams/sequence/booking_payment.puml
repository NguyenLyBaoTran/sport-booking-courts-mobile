
@startuml
title Booking and Payment Sequence Diagram

autonumber

skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam sequence {
    ArrowColor #526477
    ArrowThickness 1.2
    LifeLineBorderColor #B8C7D9
    LifeLineBackgroundColor white
    ParticipantBorderColor #AABBD0
    ParticipantBackgroundColor #EAF1F8
    ParticipantFontColor #34465A
    ActorBorderColor #AABBD0
    ActorBackgroundColor #EAF1F8
    ActorFontColor #34465A
    ActivationBorderColor #526477
    ActivationBackgroundColor #E8EEF5
    GroupBorderColor #C6D4E3
    GroupBackgroundColor #F8FAFC
    GroupHeaderFontColor #34465A
    GroupHeaderFontStyle bold
    DatabaseBorderColor #AABBD0
    DatabaseBackgroundColor #F1F5F9
}

actor Customer
participant "Android App" as App
participant "API Gateway" as Gateway
participant "Booking Service" as Booking
participant "Court Service" as Court
participant "Payment Service" as Payment
database Database as DB

Customer -> App: Select court and one or more time slots
Customer -> App: Confirm booking

App -> Gateway: POST /api/v1/bookings
Gateway -> Booking: Forward booking request

Booking -> Court: Get slot quote
Court -> DB: Check slot availability
DB --> Court: Slot information
Court --> Booking: Quote and availability result

Booking -> Court: Hold selected slots
Court -> DB: Hold selected slots
DB --> Court: Hold result

alt Slots unavailable
    Court --> Booking: Hold rejected
    Booking --> Gateway: 409 Conflict
    Gateway --> App: Booking failed
    App --> Customer: Display unavailable slots

else Slots held successfully
    Court --> Booking: Slots held successfully
    Booking -> DB: Create PENDING booking\nSet default expiry to 10 minutes
    DB --> Booking: Booking ID and details

    Booking --> Gateway: Booking created
    Gateway --> App: Return booking details
    App --> Customer: Display booking information

    Customer -> App: Confirm payment
    App -> Gateway: POST /api/v1/payments/process\n(Idempotency-Key)
    Gateway -> Payment: Forward payment request

    Payment -> Booking: GET internal payment-context
    Booking --> Payment: Booking and payment information

    Payment -> DB: Save payment result

    alt Payment successful
        DB --> Payment: Payment saved as PAID

        Payment -> Booking: POST internal /confirm
        Booking -> Court: Confirm held slots
        Court -> DB: Update slots to BOOKED
        DB --> Court: Slots updated
        Court --> Booking: Slots confirmed

        Booking -> DB: Update booking to CONFIRMED\nGenerate QR token
        DB --> Booking: Booking updated

        Booking --> Payment: Booking confirmed
        Payment --> Gateway: Payment successful
        Gateway --> App: Return payment and booking result
        App --> Customer: Display confirmation and QR code

    else Payment failed
        DB --> Payment: Payment saved as FAILED

        Payment -> Booking: POST internal /fail
        Booking -> DB: Update booking to FAILED
        Booking -> Court: Release held slots
        Court -> DB: Release selected slots
        DB --> Court: Slots released
        Court --> Booking: Release completed

        Booking --> Payment: Booking failure processed
        Payment --> Gateway: Payment failed
        Gateway --> App: Return failure result
        App --> Customer: Display payment failure
    end
end

@enduml
