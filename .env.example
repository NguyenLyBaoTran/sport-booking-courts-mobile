# Copy this file to .env at the repository root. setup.bat / setup.sh fills local secrets.
# These values configure Docker Compose only, not host-run APIs.

# Use URL-safe letters, numbers, underscores, and hyphens for these passwords.
MYSQL_DEV_ROOT_PASSWORD=replace_with_a_local_dev_only_password

# Generate independent random values; keep this file local and uncommitted.
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
INTERNAL_SERVICE_TOKEN=replace_with_a_separate_random_internal_token
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
BOOKING_HOLD_MINUTES=10

# Optional Google OAuth. The Android ID is public configuration, not a client secret.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_ANDROID_PACKAGE_NAME=com.example.sportbooking
GOOGLE_ANDROID_SHA1=

# Default local-only email provider. Mailpit credentials are intentionally blank.
SMTP_PROVIDER=mailpit
SMTP_HOST=mailpit-dev
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@sport-booking.test
SMTP_STARTTLS=false

# Browser origin(s) serving Management Web, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Listen on host interfaces so a physical Android device on the private LAN can
# reach the Gateway. Use the laptop's LAN IPv4 in the Android app, never 0.0.0.0.
GATEWAY_BIND_ADDRESS=0.0.0.0
GATEWAY_HOST_PORT=8000
